local function createToggleSwitch(parent, labelKey, initialValue, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 36)
    container.BackgroundColor3 = Color3.fromRGB(18, 20, 28)
    container.BackgroundTransparency = 0.3
    container.BorderSizePixel = 0
    container.ZIndex = 14
    container.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = container

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Color = Color3.fromRGB(45, 50, 75)
    stroke.Parent = container

    local isRTL = (CurrentLanguage == "AR")
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -60, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = getText(labelKey)
    label.TextColor3 = Color3.fromRGB(240, 240, 255)
    label.TextSize = 10
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = isRTL and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
    label.ZIndex = 15
    label.Parent = container

    table.insert(translatableLabels, {Object = label, Key = labelKey})

    local switchBg = Instance.new("TextButton")
    switchBg.Size = UDim2.new(0, 44, 0, 22)
    switchBg.Position = isRTL and UDim2.new(0, 10, 0.5, -11) or UDim2.new(1, -54, 0.5, -11)
    switchBg.BackgroundColor3 = initialValue and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(45, 50, 65)
    switchBg.Text = ""
    switchBg.AutoButtonColor = false
    switchBg.ZIndex = 15
    switchBg.Parent = container

    local switchCorner = Instance.new("UICorner")
    switchCorner.CornerRadius = UDim.new(1, 0)
    switchCorner.Parent = switchBg

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = initialValue and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.ZIndex = 16
    knob.Parent = switchBg

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    local currentState = initialValue

    local function updateState(newState)
        currentState = newState
        switchBg.BackgroundColor3 = currentState and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(45, 50, 65)
        knob.Position = currentState and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        callback(currentState)
        saveConfiguration()
    end

    local switchClick = switchBg.MouseButton1Click:Connect(function()
        updateState(not currentState)
    end)
    table.insert(Connections, switchClick)

    return {
        Container = container,
        SetState = function(val) updateState(val) end,
        GetState = function() return currentState end,
        SwitchBg = switchBg
    }
end

