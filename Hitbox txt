                CurrentTheme = CurrentTheme,
                CurrentScale = CurrentScale,
                CurrentLanguage = CurrentLanguage,
                HitboxEnabled = HitboxEnabled,
                EspEnabled = EspEnabled,
                HideHeadEnabled = HideHeadEnabled,
