-- ================================================
-- CORE HITBOX & ESP & CHAMS ENGINE
-- ================================================
local function isEnemy(player)
    if player == LocalPlayer then return false end
    if EspOverrides[player] then return EspOverrides[player] == "Red" end
    if TargetEveryone then return true end

    if LocalPlayer.Team ~= nil and player.Team ~= nil then 
        return LocalPlayer.Team ~= player.Team 
    end
    if LocalPlayer.TeamColor ~= nil and player.TeamColor ~= nil then 
        return LocalPlayer.TeamColor ~= player.TeamColor 
    end

    return true
end

local function processCharacter(player, character)
    if not character then return end

    local head = character:FindFirstChild("Head") or character:WaitForChild("Head", 0.5)
    local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 0.5)
    local enemy = isEnemy(player)

    if head then
        if not head:GetAttribute("Head_OrigTrans") then head:SetAttribute("Head_OrigTrans", head.Transparency) end

        if HideHeadEnabled then
            head.Transparency = 1
            for _, child in ipairs(head:GetChildren()) do
                if child:IsA("Decal") or child:IsA("SpecialMesh") then
                    if not child:GetAttribute("Decal_OrigTrans") then child:SetAttribute("Decal_OrigTrans", child.Transparency) end
                    child.Transparency = 1
                end
            end
        else
            head.Transparency = head:GetAttribute("Head_OrigTrans") or 0
            for _, child in ipairs(head:GetChildren()) do
                if (child:IsA("Decal") or child:IsA("SpecialMesh")) and child:GetAttribute("Decal_OrigTrans") then
                    child.Transparency = child:GetAttribute("Decal_OrigTrans")
                end
            end
        end
    end

    if root then
        if not root:GetAttribute("Root_OrigSize") then
            root:SetAttribute("Root_OrigSize", root.Size)
            root:SetAttribute("Root_OrigTrans", root.Transparency)
            root:SetAttribute("Root_OrigColor", root.Color)
            root:SetAttribute("Root_OrigMaterial", root.Material.Name)
            root:SetAttribute("Root_OrigCanCollide", root.CanCollide)
        end

        local allowHitbox = HitboxEnabled
        if HitboxOverrides[player] ~= nil then allowHitbox = HitboxEnabled and HitboxOverrides[player] end

        if allowHitbox then
            root.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
            root.Transparency = 0.6
            root.Color = getThemeColor()
            root.Material = Enum.Material.Neon
            root.CanCollide = false
        else
            root.Size = root:GetAttribute("Root_OrigSize")
            root.Transparency = root:GetAttribute("Root_OrigTrans")
            root.Color = root:GetAttribute("Root_OrigColor")
            local matName = root:GetAttribute("Root_OrigMaterial")
            pcall(function() root.Material = Enum.Material[matName] or Enum.Material.SmoothPlastic end)
            root.CanCollide = root:GetAttribute("Root_OrigCanCollide")
        end
    end

    -- Chams Material Modification
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") and part ~= root then
            if ChamsEnabled then
                if not part:GetAttribute("Orig_Mat") then part:SetAttribute("Orig_Mat", part.Material.Name) end
                part.Material = Enum.Material.Neon
            else
                if part:GetAttribute("Orig_Mat") then
                    pcall(function() part.Material = Enum.Material[part:GetAttribute("Orig_Mat")] end)
                end
            end
        end
    end

    local highlight = character:FindFirstChild("ESPHighlight")
    if EspEnabled then
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "ESPHighlight"
            highlight.Adornee = character
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Parent = character
        else
            highlight.Adornee = character
        end

        highlight.Enabled = true
        local isRedColor = enemy
        if EspOverrides[player] then isRedColor = (EspOverrides[player] == "Red") end

        if isRedColor then
            highlight.FillColor = Color3.fromRGB(255, 0, 0)
            highlight.OutlineColor = Color3.fromRGB(255, 50, 50)
        else
            highlight.FillColor = Color3.fromRGB(0, 255, 120)
            highlight.OutlineColor = Color3.fromRGB(50, 255, 150)
        end
    else
        if highlight then highlight:Destroy() end
    end
end

applyBatchOutput = function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            processCharacter(player, player.Character)
        end
    end
    GlowDot.BackgroundColor3 = (HitboxEnabled or EspEnabled or HideHeadEnabled) and Color3.fromRGB(0, 255, 120) or getThemeColor()
end

local function setupPlayerListeners(player)
    if player == LocalPlayer then return end
    if PlayerConns[player] then return end
    PlayerConns[player] = {}

    local charConn = player.CharacterAdded:Connect(function(char)
        local oldHighlight = char:FindFirstChild("ESPHighlight")
        if oldHighlight then oldHighlight:Destroy() end
        task.wait(0.3)
        processCharacter(player, char)
    end)
    table.insert(PlayerConns[player], charConn)

    if player.Character then processCharacter(player, player.Character) end
end

for _, player in ipairs(Players:GetPlayers()) do setupPlayerListeners(player) end

local pAddedConn = Players.PlayerAdded:Connect(function(player)
    setupPlayerListeners(player)
    refreshPlayerList()
end)
table.insert(Connections, pAddedConn)

local pRemovingConn = Players.PlayerRemoving:Connect(function(player)
    if LockedPlayerTarget == player then LockedPlayerTarget = nil end
    if TracingLines[player] then
        TracingLines[player]:Remove()
        TracingLines[player] = nil
    end
    if PlayerConns[player] then
        for _, conn in ipairs(PlayerConns[player]) do
            if conn and conn.Connected then conn:Disconnect() end
        end
        PlayerConns[player] = nil
    end
    HitboxOverrides[player] = nil
    EspOverrides[player] = nil
    refreshPlayerList()
end)
table.insert(Connections, pRemovingConn)

