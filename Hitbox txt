                FovCircleEnabled = FovCircleEnabled,
                TargetEveryone = TargetEveryone,
                TracersEnabled = TracersEnabled,
                ChamsEnabled = ChamsEnabled,
                FullbrightEnabled = FullbrightEnabled
            }
            writefile(CONFIG_FILE_NAME, HttpService:JSONEncode(cfg))
        end)
    end
end

loadConfiguration = function()
    if readfile and isfile and isfile(CONFIG_FILE_NAME) then
        pcall(function()
            local raw = readfile(CONFIG_FILE_NAME)
            local cfg = HttpService:JSONDecode(raw)
            if cfg then
                HitboxSize = cfg.HitboxSize or HitboxSize
                CurrentTheme = cfg.CurrentTheme or CurrentTheme
                CurrentScale = cfg.CurrentScale or CurrentScale
                CurrentLanguage = cfg.CurrentLanguage or CurrentLanguage
                HitboxEnabled = cfg.HitboxEnabled or false
                EspEnabled = cfg.EspEnabled or false
                HideHeadEnabled = cfg.HideHeadEnabled or false
                AimLockEnabled = cfg.AimLockEnabled or false
                FovCircleEnabled = cfg.FovCircleEnabled or false
                TargetEveryone = cfg.TargetEveryone or false
                TracersEnabled = cfg.TracersEnabled or false
                ChamsEnabled = cfg.ChamsEnabled or false
                FullbrightEnabled = cfg.FullbrightEnabled or false
            end
        end)
    end
end

