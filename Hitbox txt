            root.Size = root:GetAttribute("Root_OrigSize")
            root.Transparency = root:GetAttribute("Root_OrigTrans") or 1
            root.Color = root:GetAttribute("Root_OrigColor") or Color3.fromRGB(163, 162, 165)
            root.CanCollide = root:GetAttribute("Root_OrigCanCollide") ~= false
        end
        local highlight = player.Character:FindFirstChild("ESPHighlight")
        if highlight then highlight:Destroy() end
    end
end

