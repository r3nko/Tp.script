    local isRTL = (CurrentLanguage == "AR")
    local align = isRTL and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left

    Title.TextXAlignment = align
    SubTitle.TextXAlignment = align

    for _, item in ipairs(translatableLabels) do
        if item.Object and item.Object.Parent then
            if item.Object:IsA("TextLabel") or item.Object:IsA("TextBox") then
                item.Object.TextXAlignment = align
            end
            if item.Key then
                if item.Object:IsA("TextBox") then
                    item.Object.PlaceholderText = getText(item.Key)
                else
                    item.Object.Text = getText(item.Key)
                end
            end
        end
    end
end

