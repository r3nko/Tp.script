local function getClampedPosition(frame, targetPos)
    local viewportSize = Camera and Camera.ViewportSize or Vector2.new(800, 600)
    local frameSize = frame.AbsoluteSize
    local absX = (viewportSize.X * targetPos.X.Scale) + targetPos.X.Offset
    local absY = (viewportSize.Y * targetPos.Y.Scale) + targetPos.Y.Offset
    absX = math.clamp(absX, 5, viewportSize.X - frameSize.X - 5)
    absY = math.clamp(absY, 5, viewportSize.Y - frameSize.Y - 5)
    return UDim2.new(0, absX, 0, absY)
end

local function enableCustomDrag(interactiveFrame, targetFrame)
    targetFrame = targetFrame or interactiveFrame
    local dragging = false
    local dragInput, dragStart, startPos

    local inputBeganConn = interactiveFrame.InputBegan:Connect(function(input)
        if UIisLocked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position

            local inputEndedConn
            inputEndedConn = UserInputService.InputEnded:Connect(function(endInput)
                if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                    if inputEndedConn then inputEndedConn:Disconnect() end
                end
            end)
            table.insert(Connections, inputEndedConn)
        end
    end)
    table.insert(Connections, inputBeganConn)

    local inputChangedConn = interactiveFrame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    table.insert(Connections, inputChangedConn)

    local globalInputChangedConn = UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging and not UIisLocked then
            local delta = input.Position - dragStart
            local rawPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            targetFrame.Position = getClampedPosition(targetFrame, rawPos)
        end
    end)
    table.insert(Connections, globalInputChangedConn)
end

