local function _scan()
	local _f = {}
	local _s = {}
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") and not _s[obj] then
			if string.find(string.lower(obj.Name), "noob") then
				_s[obj] = true
				table.insert(_f, obj)
			end
		end
	end
	return _f
end

local function _hl(part)
	local _sb = Instance.new("SelectionBox")
	_sb.Adornee = part
	_sb.Color3 = Color3.fromRGB(0, 245, 212)
	_sb.Parent = part
	
	task.delay(0.1, function()
		if _sb and _sb.Parent then
			_sb:Destroy()
		end
	end)
end

local function _nc(char, state)
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide = not state
		end
	end
end

local function _stop()
	_SYS._run = false
	_SYS._pause = false
	_tglBtn.Text = "Start"
	_tglBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 136)
	_pseBtn.Text = "Pause"
	_sLbl.Text = "Status: Stopped"
	
	local _ch = localPlayer.Character
	if _ch then _nc(_ch, false) end
end

