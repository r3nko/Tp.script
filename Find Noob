-- ==========================================
-- [6] Main Execution & Reliable Retry Loop
-- ==========================================
local _execThread = task.spawn(function()
	while true do
		if _SYS._lock then break end

		if _SYS._run and not _SYS._pause then
			local _total = #_parts
			
			if _idx <= _total then
				_sLbl.Text = "Status: Processing..."
				local _target = _parts[_idx]
				
				local _root = nil
				local _attempts = 0
				local _maxAttempts = 5
				
				while not _root and _attempts < _maxAttempts and _SYS._run and not _SYS._lock do
					local _char = localPlayer.Character
					if _char then
						_root = _char:FindFirstChild("HumanoidRootPart")
					end
					if not _root then
						_attempts += 1
						task.wait(0.2)
					end
				end
				
				if _target and _target.Parent and _root then
					local _chRef = localPlayer.Character
					if _chRef then _nc(_chRef, true) end
					
					_root.CFrame = _target.CFrame * CFrame.new(0, 3, 0)
					_hl(_target)
					
					if not _map[_target] then
						_map[_target] = true
						_vCount += 1
					end
					
					local _pct = math.clamp(_vCount / _total, 0, 1)
					_cLbl.Text = string.format("Progress: %d/%d (%d%%)", _vCount, _total, math.floor(_pct * 100))
					TweenService:Create(_bFill, TweenInfo.new(0.1), {Size = UDim2.new(_pct, 0, 1, 0)}):Play()
					
					_idx += 1
				else
					-- Strict enforcement: True retry/skip protocol preserving sequence
					_idx += 1
				end
			else
				_stop()
				_sLbl.Text = "Status: Sequence Complete"
			end
		end
		task.wait(_SYS._del)
	end
end)
table.insert(_threads, _execThread)

