local function switchTab(name)
    if activeTabName == name then return end
    activeTabName = name
    for tName, tBtn in pairs(tabs) do
        local isActive = (tName == name)
        TweenService:Create(tBtn, TweenInfo.new(0.2), {
            BackgroundColor3 = isActive and getThemeColor() or Color3.fromRGB(20, 22, 32),
            BackgroundTransparency = isActive and 0.2 or 0.4,
            TextColor3 = isActive and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(140, 145, 175)
        }):Play()
        tBtn.UIStroke.Color = isActive and getThemeColor() or Color3.fromRGB(45, 50, 75)
    end
    for pName, pFrame in pairs(pages) do
        if pName == name then
            pFrame.Visible = true
            pFrame.Position = UDim2.new(0.05, 0, 0, 0)
            TweenService:Create(pFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
        else
            pFrame.Visible = false
        end
    end
end

