    cleanupRowConnections()
    for _, conn in ipairs(Connections) do
        if conn and conn.Connected then conn:Disconnect() end
    end
    for _, line in pairs(TracingLines) do
        if line then line:Remove() end
    end
    table.clear(TracingLines)
    table.clear(HitboxOverrides)
    table.clear(EspOverrides)

    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local root = char:FindFirstChild("HumanoidRootPart")
            local highlight = char:FindFirstChild("ESPHighlight")

            if head then
                head.Transparency = head:GetAttribute("Head_OrigTrans") or 0
                for _, child in ipairs(head:GetChildren()) do
                    if (child:IsA("Decal") or child:IsA("SpecialMesh")) and child:GetAttribute("Decal_OrigTrans") then
                        child.Transparency = child:GetAttribute("Decal_OrigTrans")
                    end
                end
            end

            if root and root:GetAttribute("Root_OrigSize") then
                root.Size = root:GetAttribute("Root_OrigSize")
                root.Transparency = root:GetAttribute("Root_OrigTrans") or 1
                root.Color = root:GetAttribute("Root_OrigColor") or Color3.fromRGB(163, 162, 165)
                local matName = root:GetAttribute("Root_OrigMaterial")
                pcall(function() root.Material = Enum.Material[matName] or Enum.Material.SmoothPlastic end)
                root.CanCollide = root:GetAttribute("Root_OrigCanCollide") ~= false
            end

            if highlight then highlight:Destroy() end
        end
    end
end)
