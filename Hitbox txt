-- Camera Tracking & Viewport Boundaries
local camera = workspace.CurrentCamera
local camConn = workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    camera = workspace.CurrentCamera
end)
table.insert(Connections, camConn)

local function getClampedPosition(frame, targetPos)
    local viewportSize = camera and camera.ViewportSize or Vector2.new(800, 600)
    local frameSize = frame.AbsoluteSize
    local x = math.clamp(targetPos.X.Offset, 10, viewportSize.X - frameSize.X - 10)
    local y = math.clamp(targetPos.Y.Offset, 10, viewportSize.Y - frameSize.Y - 10)
    return UDim2.new(targetPos.X.Scale, x, targetPos.Y.Scale, y)
end

-- ================================================
-- UNIVERSAL DRAG ENGINE
-- ================================================
local function enableCustomDrag(frame)
    local dragging = false
    local dragInput, dragStart, startPos

    local inputBeganConn = frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            local inputEndedConn
            inputEndedConn = UserInputService.InputEnded:Connect(function(endInput)
                if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                    if inputEndedConn then inputEndedConn:Disconnect() end
                end
            end)
            table.insert(Connections, inputEndedConn)
        end
    end)

    local inputChangedConn = frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    local globalInputChangedConn = UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            local rawPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            frame.Position = getClampedPosition(frame, rawPos)
        end
    end)

    table.insert(Connections, inputBeganConn)
    table.insert(Connections, inputChangedConn)
    table.insert(Connections, globalInputChangedConn)
end

