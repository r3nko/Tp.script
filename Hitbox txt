local frameCount = 0
local lastCheck = tick()
local fpsHistory = {}
local pingHistory = {}

local renderConn = RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local now = tick()

    if HeaderShowClock then
        SubTitle.Text = os.date("%H:%M:%S")
    end

    -- Smooth AimLock Logic
    if AimLockEnabled then
        local targetRoot = nil
        if LockedPlayerTarget and LockedPlayerTarget.Character then
            local hum = LockedPlayerTarget.Character:FindFirstChild("Humanoid")
            local root = LockedPlayerTarget.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root then
                targetRoot = root
            else
                LockedPlayerTarget = nil
            end
        end

        if not targetRoot then
            local closestDist = math.huge
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local hum = player.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        local root = player.Character.HumanoidRootPart
                        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                            if dist < FovRadius and dist < closestDist then
                                closestDist = dist
                                targetRoot = root
                            end
                        end
                    end
                end
            end
        end

        if targetRoot then
            local targetCFrame = CFrame.new(Camera.CFrame.Position, targetRoot.Position)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.2)
        end
    end

    -- Tracers Rendering Loop
    if TracersEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local root = player.Character.HumanoidRootPart
                local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                
                if onScreen then
                    local line = TracingLines[player]
                    if not line and Drawing then
                        line = Drawing.new("Line")
                        line.Thickness = 1.5
                        line.Transparency = 0.7
                        TracingLines[player] = line
                    end
                    if line then
                        line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        line.To = Vector2.new(screenPos.X, screenPos.Y)
                        line.Color = getThemeColor()
                        line.Visible = true
                    end
                else
                    if TracingLines[player] then TracingLines[player].Visible = false end
                end
            else
                if TracingLines[player] then TracingLines[player].Visible = false end
            end
        end
    end

    if now - lastCheck >= 1 then
        local fps = math.floor(frameCount / (now - lastCheck))
        local ping = 0
        pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
        
        table.insert(fpsHistory, fps)
        table.insert(pingHistory, ping)
        if #fpsHistory > 5 then table.remove(fpsHistory, 1) end
        if #pingHistory > 5 then table.remove(pingHistory, 1) end

        local avgFps = 0
        for _, f in ipairs(fpsHistory) do avgFps = avgFps + f end
        avgFps = math.floor(avgFps / #fpsHistory)

        local avgPing = 0
        for _, p in ipairs(pingHistory) do avgPing = avgPing + p end
        avgPing = math.floor(avgPing / #pingHistory)

        local uptimeSec = math.floor(now - StartTime)
        local memMb = gcinfo and (gcinfo() / 1024) or 0

        if avgFps < 30 then
            ActualParticlesEnabled = false
        elseif avgFps > 45 and UserParticlesEnabled then
            ActualParticlesEnabled = true
        end

        local statusText = getText("StatusExcellent")
        local statusColor = Color3.fromRGB(0, 255, 120)

        if avgFps >= 50 and avgPing < 120 then
            statusText = getText("StatusExcellent")
            statusColor = Color3.fromRGB(0, 255, 120)
        elseif avgFps >= 30 and avgPing < 200 then
            statusText = getText("StatusModerate")
            statusColor = Color3.fromRGB(255, 200, 0)
        else
            statusText = getText("StatusLag")
            statusColor = Color3.fromRGB(255, 60, 60)
        end

        PerformanceLabel.Text = string.format("FPS: %d (Avg: %d) | PING: %dms (Avg: %d)\nUptime: %ds | Memory: %.1f MB\n%s", fps, avgFps, ping, avgPing, uptimeSec, memMb, statusText)
        PerformanceLabel.TextColor3 = statusColor

        frameCount = 0
        lastCheck = now
    end
end)
