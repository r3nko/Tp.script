-- Team Check
local function isEnemy(player)
    if player == LocalPlayer then return false end
    if EspOverrides[player] then return EspOverrides[player] == "Red" end

    if LocalPlayer.Team ~= nil and player.Team ~= nil then return LocalPlayer.Team ~= player.Team end
    if LocalPlayer.TeamColor ~= nil and player.TeamColor ~= nil then return LocalPlayer.TeamColor ~= player.TeamColor end

    local lpTeam = LocalPlayer:FindFirstChild("Team") or (LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("Team"))
    local pTeam = player:FindFirstChild("Team") or (player:FindFirstChild("leaderstats") and player.leaderstats:FindFirstChild("Team"))
    if lpTeam and pTeam and lpTeam.Value and pTeam.Value then return lpTeam.Value ~= pTeam.Value end

    return false
end

-- Core Character Process Logic
processCharacter = function(player, character)
    if not character then return end

    local head = character:FindFirstChild("Head") or character:WaitForChild("Head", 0.5)
    local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 0.5)
    local enemy = isEnemy(player)

    if head then
        if not head:GetAttribute("Head_OrigTrans") then head:SetAttribute("Head_OrigTrans", head.Transparency) end

        if HideHeadEnabled then
            head.Transparency = 1
            for _, child in ipairs(head:GetChildren()) do
                if child:IsA("Decal") or child:IsA("SpecialMesh") then
                    if not child:GetAttribute("Decal_OrigTrans") then child:SetAttribute("Decal_OrigTrans", child.Transparency) end
                    child.Transparency = 1
                end
            end
        else
            head.Transparency = head:GetAttribute("Head_OrigTrans") or 0
            for _, child in ipairs(head:GetChildren()) do
                if (child:IsA("Decal") or child:IsA("SpecialMesh")) and child:GetAttribute("Decal_OrigTrans") then
                    child.Transparency = child:GetAttribute("Decal_OrigTrans")
                end
            end
        end
    end

    if root then
        if not root:GetAttribute("Root_OrigSize") then
            root:SetAttribute("Root_OrigSize", root.Size)
            root:SetAttribute("Root_OrigTrans", root.Transparency)
            root:SetAttribute("Root_OrigColor", root.Color)
            root:SetAttribute("Root_OrigMaterial", root.Material.Name)
            root:SetAttribute("Root_OrigCanCollide", root.CanCollide)
        end

        local allowHitbox = HitboxEnabled
        if HitboxOverrides[player] ~= nil then allowHitbox = HitboxEnabled and HitboxOverrides[player] end

        if allowHitbox then
            root.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
            root.Transparency = 0.6
            root.Color = Color3.fromRGB(0, 230, 255)
            root.Material = Enum.Material.Neon
            root.CanCollide = false
        else
            root.Size = root:GetAttribute("Root_OrigSize")
            root.Transparency = root:GetAttribute("Root_OrigTrans")
            root.Color = root:GetAttribute("Root_OrigColor")
            local matName = root:GetAttribute("Root_OrigMaterial")
            pcall(function() root.Material = Enum.Material[matName] or Enum.Material.SmoothPlastic end)
            root.CanCollide = root:GetAttribute("Root_OrigCanCollide")
        end
    end

    local highlight = character:FindFirstChild("ESPHighlight")
    if EspEnabled then
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "ESPHighlight"
            highlight.Adornee = character
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Parent = character
        else
            highlight.Adornee = character
        end

        highlight.Enabled = true
        local isRedColor = enemy
        if EspOverrides[player] then isRedColor = (EspOverrides[player] == "Red") end

        if isRedColor then
            highlight.FillColor = Color3.fromRGB(255, 0, 0)
            highlight.OutlineColor = Color3.fromRGB(255, 50, 50)
        else
            highlight.FillColor = Color3.fromRGB(0, 255, 120)
            highlight.OutlineColor = Color3.fromRGB(50, 255, 150)
        end
    else
        if highlight then highlight:Destroy() end
    end
end

-- Direct Toggle Instant Triggers
local function applyBatchUpdate()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            processCharacter(player, player.Character)
        end
    end
    GlowDot.BackgroundColor3 = (HitboxEnabled or EspEnabled or HideHeadEnabled) and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(0, 230, 255)
end

HitboxBtn.MouseButton1Click:Connect(function()
    HitboxEnabled = not HitboxEnabled
    HitboxBtn.Text = HitboxEnabled and "HITBOX: ACTIVE" or "HITBOX: OFF"
    applyBatchUpdate()
end)

EspBtn.MouseButton1Click:Connect(function()
    EspEnabled = not EspEnabled
    EspBtn.Text = EspEnabled and "ESP: ACTIVE" or "ESP: OFF"
    applyBatchUpdate()
end)

HeadBtn.MouseButton1Click:Connect(function()
    HideHeadEnabled = not HideHeadEnabled
    HeadBtn.Text = HideHeadEnabled and "HIDE HEAD: ACTIVE" or "HIDE HEAD: OFF"
    applyBatchUpdate()
end)

SizeInput.FocusLost:Connect(function()
    local val = tonumber(SizeInput.Text)
    if val and val >= 1 and val <= 50 then
        HitboxSize = val
        if HitboxEnabled then applyBatchUpdate() end
    else
        SizeInput.Text = tostring(HitboxSize)
    end
end)

-- Player Join & Respawn Hook
local function setupPlayerListeners(player)
    if player == LocalPlayer then return end
    PlayerConns[player] = {}

    local charConn = player.CharacterAdded:Connect(function(char)
        local oldHighlight = char:FindFirstChild("ESPHighlight")
        if oldHighlight then oldHighlight:Destroy() end

        task.wait(0.3)
        processCharacter(player, char)
    end)
    table.insert(PlayerConns[player], charConn)

    if player.Character then processCharacter(player, player.Character) end
end

for _, player in ipairs(Players:GetPlayers()) do setupPlayerListeners(player) end

local pAddedConn = Players.PlayerAdded:Connect(function(player)
    setupPlayerListeners(player)
    triggerDropdownRefreshes()
end)
table.insert(Connections, pAddedConn)

local pRemovingConn = Players.PlayerRemoving:Connect(function(player)
    if PlayerConns[player] then
        for _, conn in ipairs(PlayerConns[player]) do
            if conn and conn.Connected then conn:Disconnect() end
        end
        PlayerConns[player] = nil
    end
    HitboxOverrides[player] = nil
    EspOverrides[player] = nil
    triggerDropdownRefreshes()
end)
table.insert(Connections, pRemovingConn)

ScreenGui.Destroying:Connect(function()
    for _, conn in ipairs(Connections) do
        if conn and conn.Connected then conn:Disconnect() end
    end
    for player, conns in pairs(PlayerConns) do
        for _, conn in ipairs(conns) do
            if conn and conn.Connected then conn:Disconnect() end
        end
    end
    table.clear(dropdownRefreshers)
    table.clear(HitboxOverrides)
    table.clear(EspOverrides)

    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local root = char:FindFirstChild("HumanoidRootPart")
            local highlight = char:FindFirstChild("ESPHighlight")

            if head then
                head.Transparency = head:GetAttribute("Head_OrigTrans") or 0
                for _, child in ipairs(head:GetChildren()) do
                    if (child:IsA("Decal") or child:IsA("SpecialMesh")) and child:GetAttribute("Decal_OrigTrans") then
                        child.Transparency = child:GetAttribute("Decal_OrigTrans")
                    end
                end
            end

            if root and root:GetAttribute("Root_OrigSize") then
                root.Size = root:GetAttribute("Root_OrigSize")
                root.Transparency = root:GetAttribute("Root_OrigTrans") or 1
                root.Color = root:GetAttribute("Root_OrigColor") or Color3.fromRGB(163, 162, 165)
                local matName = root:GetAttribute("Root_OrigMaterial")
                pcall(function() root.Material = Enum.Material[matName] or Enum.Material.SmoothPlastic end)
                root.CanCollide = root:GetAttribute("Root_OrigCanCollide") ~= false
            end

            if highlight then highlight:Destroy() end
        end
    end
end)

-- Main Loop Engine
task.spawn(function()
    while ScreenGui and ScreenGui.Parent do
        if HitboxEnabled or EspEnabled or HideHeadEnabled then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    processCharacter(player, player.Character)
                end
            end
            task.wait(0.1)
        else
            task.wait(0.4)
        end
    end
end)
